{
  "name": "nucleo-viewer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api": "uv run --project ../backend uvicorn app.main:app --app-dir ../backend --host 127.0.0.1 --port 8000",
    "web": "vite",
    "dev:all": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.6",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
